# Copie para .env (não versionado) e ajuste. Sem estas variáveis o app
# roda 100% local: SQLite + pasta saved_models/.

# --- Cloud SQL (PostgreSQL) ---
# Opção 1: URL completa (ex.: via Cloud SQL Auth Proxy em localhost)
# DATABASE_URL=postgresql://app_user:SENHA@127.0.0.1:5432/business_ai
# Opção 2: socket Unix (padrão no Cloud Run)
# INSTANCE_CONNECTION_NAME=meu-projeto:southamerica-east1:decision-intel-db
# DB_NAME=business_ai
# DB_USER=app_user
# DB_PASS=SENHA

# --- Cloud Storage (modelos .pkl) ---
# GCS_BUCKET=meu-projeto-decision-intel
# GCS_MODEL_PREFIX=saved_models

# --- Gemini via Vertex AI (Copilot e AI Chat) ---
# Localmente: gcloud auth application-default login
# GEMINI_ENABLED=true
# GOOGLE_CLOUD_PROJECT=meu-projeto
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_SAMPLE_ROWS=5     # 0 = não envia linhas de amostra, só esquema/estatísticas
# GEMINI_LANGUAGE=Brazilian Portuguese
